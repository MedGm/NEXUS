{
  "title": "NEXUS Inference & Anomaly Scores",
  "uid": "nexus-inference",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Rolling Anomaly Score by Dataset",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "targets": [
        {
          "expr": "nexus_anomaly_score",
          "legendFormat": "{{dataset}}",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 2,
      "title": "Inference Total by Tier",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "nexus_inference_total",
          "legendFormat": "{{dataset}} / {{tier}}",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 3,
      "title": "Anomaly Detections",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 10},
      "targets": [
        {
          "expr": "nexus_inference_anomalies_total",
          "legendFormat": "{{dataset}} anomalies",
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ]
}
